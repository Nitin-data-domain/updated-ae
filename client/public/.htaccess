<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} ^(www\.)?aharadaedu\.(com|in)$ [NC]
  RewriteRule ^(.*)$ https://aharadaedu.com/$1 [R=301,L]

  # 2. Redirect old .in domain (and www.aharadaedu.in) to https://aharadaedu.com
  RewriteCond %{HTTP_HOST} ^(www\.)?aharadaedu\.in$ [NC]
  RewriteRule ^(.*)$ https://aharadaedu.com/$1 [R=301,L]

  # 3. Redirect www.aharadaedu.com to non-www https://aharadaedu.com
  RewriteCond %{HTTP_HOST} ^www\.aharadaedu\.com$ [NC]
  RewriteRule ^(.*)$ https://aharadaedu.com/$1 [R=301,L]

  # 4. Exclude static root files from rewrites so robots.txt, sitemap.xml, llms.txt always serve raw
  RewriteCond %{REQUEST_URI} ^/(robots\.txt|sitemap\.xml|llms\.txt|favicon\.ico|favicon-square\.png)$ [NC]
  RewriteRule ^ - [L]

  # 5. Redirect legacy flat program URLs to /programs/
  RewriteRule ^btech-aerospace-engineering/?$ /programs/btech-aerospace-engineering [R=301,L]
  RewriteRule ^btech-aerospace/?$ /programs/btech-aerospace-engineering [R=301,L]
  RewriteRule ^btech-aero/?$ /programs/btech-aerospace-engineering [R=301,L]
  RewriteRule ^bba-aviation-travel/?$ /programs/bba-aviation-travel [R=301,L]
  RewriteRule ^bba-aviation/?$ /programs/bba-aviation-travel [R=301,L]
  RewriteRule ^bsc-aeronautical-science/?$ /programs/bsc-aeronautical-science [R=301,L]
  RewriteRule ^bsc-aviation/?$ /programs/bsc-aeronautical-science [R=301,L]
  RewriteRule ^mba-aviation-management/?$ /programs/mba-aviation-management [R=301,L]
  RewriteRule ^mba-aviation/?$ /programs/mba-aviation-management [R=301,L]
  RewriteRule ^bba-entrepreneurship-innovation/?$ /programs/bba-entrepreneurship-innovation [R=301,L]
  RewriteRule ^bba-entrepreneurship/?$ /programs/bba-entrepreneurship-innovation [R=301,L]
  RewriteRule ^bba-data-analytics-ai/?$ /programs/bba-data-analytics-ai [R=301,L]
  RewriteRule ^bba-analytics/?$ /programs/bba-data-analytics-ai [R=301,L]
  RewriteRule ^bachelor-fashion-design/?$ /programs/bachelor-fashion-design [R=301,L]
  RewriteRule ^fashion-design/?$ /programs/bachelor-fashion-design [R=301,L]
  RewriteRule ^bachelor-fine-arts/?$ /programs/bachelor-fine-arts [R=301,L]
  RewriteRule ^fine-arts/?$ /programs/bachelor-fine-arts [R=301,L]
  RewriteRule ^about-us/?$ /about [R=301,L]
  RewriteRule ^contact-us/?$ /contact [R=301,L]
  RewriteRule ^placements/?$ /placement [R=301,L]
  RewriteRule ^courses/?$ /programs [R=301,L]
  RewriteRule ^courses/(.*)$ /programs/$1 [R=301,L]
  RewriteRule ^course/(.*)$ /programs/$1 [R=301,L]
  RewriteRule ^books/?$ /library [R=301,L]
  RewriteRule ^digital-library/?$ /library [R=301,L]
</IfModule>

# ── Enable Gzip Compression (mod_deflate) ──────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2
</IfModule>

# ── Browser Caching & Expiry Headers (mod_expires) ─────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML pages - dynamic & immediate update
  ExpiresByType text/html "access plus 0 seconds"

  # Versioned CSS & JS chunks - 1 year
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"

  # Images & Vector graphics
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Web Fonts
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
</IfModule>

# ── Security & Performance Headers ─────────────────────────────────────────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
